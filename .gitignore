# OS が生成するファイル
.DS_Store
Thumbs.db

# エディタ
.vscode/
.idea/
*.swp
*~

# バックアップ・汚染版(Git 履歴で代替)
*.bak
*.contaminated.*

# ローカル限定
HANDOFF_LOCAL.md
HANDOFF.md.contaminated.bak

# Stage A クラウド設定の実値（Supabase URL / publishable key）。public repo に載せない。
# ひな形 app/config.example.js のみコミットし、実値は app/config.js（非コミット）に置く。
app/config.js

# 実データ・ローカル投入データ（実参加者マスタ等）は repo に含めない（端末ローカル限定 / 先頭スラッシュで repo 直下のみ）
/data/

# ai-requests のうちローカル限定のもの
ai-requests/local/

# Node / Playwright
node_modules/
test-results/
playwright-report/
# changelog_merge の永続 transaction と lock。--changelog で docs 外を指定しても stage しない
# よう、先頭スラッシュ無し（任意の深さで照合）にしてある。
.changelog_merge.lock/
.changelog_merge.txn.*/

# [E2E-MUT-SKIP-001] 変異チェックの「この入力は実測で緑だった」記録。
# ★ 意図的に **コミットしない**: クリーン checkout（＝CI）には存在しない
#   ＝ CI は必ずフル実行になる、という安全網をこの1行が支えている。
.mutcache/

# [LAND-BUNDLE-001] scripts/land.sh が push 済み bundle を退避する場所とログ。
# bundle 自体も repo に入れない（1本 1MB 前後・受け渡しの一時物）。
_landed/
/*.bundle
/*.bundle.force
# ★ Codex P2 (r3794610410): 隔離後・処理中の名前も ignore に含める。
#   1本 1MB 前後の受け渡しデータが untracked で現れ、素の `git add` で誤ってコミットできてしまう。
/*.bundle.failed
/*.bundle.force.failed
/*.bundle.landing-*
